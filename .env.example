# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Dự án: Food Order Backend (Spring Boot)
# Hướng dẫn: 
# 1. Sao chép file này thành file '.env' hoặc cấu hình trong môi trường của bạn / IDE / Docker:
#    cp .env.example .env
# 2. Điền đầy đủ các giá trị cấu hình thực tế của bạn trước khi chạy dự án.
# LƯU Ý: Không bao giờ commit file chứa thông tin bí mật thực tế (.env) lên git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/food_order
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# ------------------------------------------------------------------------------
# 2. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
SERVER_PORT=8081

# ------------------------------------------------------------------------------
# 3. JWT (JSON WEB TOKEN) SECURITY
# ------------------------------------------------------------------------------
# Khóa bí mật dùng để ký và xác thực JWT token (chuỗi hex 256-bit hoặc chuỗi ngẫu nhiên dài)
JWT_SECRET_KEY=

# ------------------------------------------------------------------------------
# 4. GMAIL SMTP (GỬI EMAIL THÔNG BÁO)
# ------------------------------------------------------------------------------
# Địa chỉ email Gmail gửi thư
MAIL_USERNAME=
# Mật khẩu ứng dụng (App Password 16 ký tự của Gmail, không phải mật khẩu tài khoản)
MAIL_PASSWORD=

# ------------------------------------------------------------------------------
# 5. GROQ AI API (CHATBOT HỖ TRỢ KHÁCH HÀNG)
# ------------------------------------------------------------------------------
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=
GROQ_API_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 6. PAYOS PAYMENT GATEWAY (CỔNG THANH TOÁN QR)
# ------------------------------------------------------------------------------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_LOG_LEVEL=NONE

# ------------------------------------------------------------------------------
# 7. CLOUDINARY (LƯU TRỮ VÀ QUẢN LÝ ẢNH)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


